[Unit]
Description=CoreOps infrastructure control plane
Documentation=https://github.com/ppdev28/CoreOps
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/etc/coreops/configured

[Service]
Type=simple
User=coreops
Group=coreops
WorkingDirectory=/var/lib/coreops
EnvironmentFile=/etc/coreops/coreops.env
ExecStart=/usr/bin/coreops-api
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
StateDirectory=coreops
StateDirectoryMode=0700
CacheDirectory=coreops
CacheDirectoryMode=0700
UMask=0077
# Narrow sudo helpers need privilege transitions. Files/Terminal inspect the real
# host filesystem; do not pretend these capabilities are sandboxed.
NoNewPrivileges=false
ProtectHome=false
PrivateTmp=false

[Install]
WantedBy=multi-user.target
