# Managed as a dpkg conffile. Configure with sudo coreops-setup.
# Keep loopback until an administrator chooses a private address or TLS proxy.
COREOPS_HOST=127.0.0.1
COREOPS_PORT=8082
COREOPS_DATA_DIR=/var/lib/coreops
COREOPS_WEB_DIR=/usr/share/coreops/web
COREOPS_TRIVY_CACHE=/var/cache/coreops/trivy
