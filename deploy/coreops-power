#!/bin/sh
# Fixed power actions only. Install root-owned with install-power-helper.sh.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ "$#" = 1 ] || exit 64
case "$1" in status|poweroff|reboot|suspend) ;; *) exit 64 ;; esac
[ "$(/usr/bin/id -u)" = 0 ] || exit 77
if [ "$1" = status ]; then
    capability() {
        value=$(/usr/bin/busctl --system --timeout=2 call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager "$1" 2>/dev/null) || value=unknown
        case "$value" in
            's "yes"') printf yes ;;
            's "no"') printf no ;;
            's "na"') printf na ;;
            's "challenge"') printf challenge ;;
            *) printf unknown ;;
        esac
    }
    printf '{"protocol":1,"states":{"poweroff":"%s","reboot":"%s","suspend":"%s"}}\n' "$(capability CanPowerOff)" "$(capability CanReboot)" "$(capability CanSuspend)"
    exit 0
fi
# Respect inhibitors and return after queue acceptance. Never use force/ignore.
exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C LC_ALL=C /usr/bin/systemctl --no-ask-password --check-inhibitors=yes --no-block "$1"
