#!/bin/sh
# Fixed power actions only. Install root-owned with install-power-helper.sh.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ "$#" = 1 ] || exit 64
case "$1" in status|poweroff|reboot|suspend) ;; *) exit 64 ;; esac
[ "$(/usr/bin/id -u)" = 0 ] || exit 77
if [ "$1" = status ]; then
    capability() {
        value=$(/usr/bin/busctl --system --timeout=2 call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager "$1" 2>/dev/null) || value=unknown
        case "$value" in
            's "yes"') printf yes ;;
            's "no"') printf no ;;
            's "na"') printf na ;;
            's "challenge"') printf challenge ;;
            *) printf unknown ;;
        esac
    }
    printf '{"protocol":1,"states":{"poweroff":"%s","reboot":"%s","suspend":"%s"}}\n' "$(capability CanPowerOff)" "$(capability CanReboot)" "$(capability CanSuspend)"
    exit 0
fi
# systemctl --check-inhibitors=yes also refuses logged-in users, including the
# administrator's own SSH sessions when invoked through sudo. Ask logind directly:
# flag 1 (SD_LOGIND_ROOT_CHECK_INHIBITORS) preserves its inhibitor checks for root.
# No interactive authorization, skip-inhibitors flag, force or fallback dispatch.
case "$1" in
    poweroff) method=PowerOffWithFlags ;;
    reboot) method=RebootWithFlags ;;
    suspend) method=SuspendWithFlags ;;
esac
exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C LC_ALL=C /usr/bin/busctl --system --timeout=4 --allow-interactive-authorization=no call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager "$method" t 1
