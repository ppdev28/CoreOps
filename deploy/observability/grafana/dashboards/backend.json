      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20,sum by(method,route)(rate(coreops_http_requests_total{job=\"$job\",instance=~\"$instance\",transport=\"http\"}[5m])))",
          "legendFormat": "{{method}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
