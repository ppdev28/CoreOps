{
  "uid": "coreops-backend",
  "title": "CoreOps \u00b7 Backend",
  "schemaVersion": 40,
  "version": 1,
  "tags": [
    "CoreOps",
    "provisioned"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Provisioned by CoreOps. A successful scrape is not a guarantee of application health. Missing samples remain gaps.",
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "coreops-prometheus"
        },
        "query": {
          "query": "label_values(up, job)",
          "refId": "job"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "coreops-api",
          "value": "coreops-api"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "coreops-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"$job\"}, instance)",
          "refId": "instance"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP traffic (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "coreops-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(coreops_http_requests_total{job=\"$job\",instance=~\"$instance\",transport=\"http\"}[5m]))",
          "legendFormat": "requests/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx ratio (no traffic = unavailable)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "coreops-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(coreops_http_requests_total{job=\"$job\",instance=~\"$instance\",transport=\"http\",code=~\"5..\"}[5m])) or (0 * sum(rate(coreops_http_requests_total{job=\"$job\",instance=~\"$instance\",transport=\"http\"}[5m])))) / sum(rate(coreops_http_requests_total{job=\"$job\",instance=~\"$instance\",transport=\"http\"}[5m]))",
          "legendFormat": "5xx %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Latency p50 (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "coreops-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5,sum by(le)(rate(coreops_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",transport=\"http\"}[5m])))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Latency p95 (5m)",
