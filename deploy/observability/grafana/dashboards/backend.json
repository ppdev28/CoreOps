      "datasource": {
        "type": "prometheus",
        "uid": "coreops-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99,sum by(le)(rate(coreops_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",transport=\"http\"}[5m])))",
