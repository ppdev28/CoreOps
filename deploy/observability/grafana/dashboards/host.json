{
  "uid": "coreops-host",
  "title": "CoreOps \u00b7 Host",
  "schemaVersion": 40,
  "version": 1,
  "tags": [
    "CoreOps",
    "provisioned"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Provisioned by CoreOps. A successful scrape is not a guarantee of application health. Missing samples remain gaps.",
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "coreops-prometheus"
        },
        "query": {
          "query": "label_values(up, job)",
          "refId": "job"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "coreops-host",
          "value": "coreops-host"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "coreops-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"$job\"}, instance)",
          "refId": "instance"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU non-idle (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "coreops-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(job,instance)(rate(node_cpu_seconds_total{job=\"$job\",instance=~\"$instance\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Memory used (total minus available)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "coreops-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"$job\",instance=~\"$instance\"}/node_memory_MemTotal_bytes{job=\"$job\",instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Writable filesystem occupancy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "coreops-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * (1 - node_filesystem_avail_bytes{job=\"$job\",instance=~\"$instance\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|proc|sysfs|cgroup.*|nsfs|autofs|tracefs|debugfs|securityfs|pstore|fusectl|ramfs\",mountpoint!~\"^/(dev|proc|sys|run|var/lib/docker|var/lib/containers)($|/).*\"}/node_filesystem_size_bytes{job=\"$job\",instance=~\"$instance\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|proc|sysfs|cgroup.*|nsfs|autofs|tracefs|debugfs|securityfs|pstore|fusectl|ramfs\",mountpoint!~\"^/(dev|proc|sys|run|var/lib/docker|var/lib/containers)($|/).*\"})) and on(job,instance,device,mountpoint) (node_filesystem_readonly{job=\"$job\",instance=~\"$instance\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|proc|sysfs|cgroup.*|nsfs|autofs|tracefs|debugfs|securityfs|pstore|fusectl|ramfs\",mountpoint!~\"^/(dev|proc|sys|run|var/lib/docker|var/lib/containers)($|/).*\"} == 0)",
          "legendFormat": "{{instance}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Uptime",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "coreops-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - node_boot_time_seconds{job=\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Network receive (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "coreops-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job,instance)(rate(node_network_receive_bytes_total{job=\"$job\",instance=~\"$instance\",device!~\"lo|veth.*|docker.*|br-.*|cni.*|flannel.*|virbr.*|tailscale.*|tun.*|tap.*\"}[5m]))",
          "legendFormat": "{{instance}} RX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Network transmit (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "coreops-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job,instance)(rate(node_network_transmit_bytes_total{job=\"$job\",instance=~\"$instance\",device!~\"lo|veth.*|docker.*|br-.*|cni.*|flannel.*|virbr.*|tailscale.*|tun.*|tap.*\"}[5m]))",
          "legendFormat": "{{instance}} TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Scrape result",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "coreops-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"$job\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
