#!/usr/bin/python3 -I
"""Restricted local Tailscale operations. Install root-owned, never as a proxy."""
import http.client
import json
import os
import re
import socket
import stat
import sys

SOCKET = "/var/run/tailscale/tailscaled.sock"
LIMIT = 2 * 1024 * 1024

class UnixHTTP(http.client.HTTPConnection):
    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(3)
        self.sock.connect(SOCKET)

def trusted_socket():
    for path in (os.path.dirname(SOCKET), SOCKET):
        info = os.lstat(path)
        if stat.S_ISLNK(info.st_mode) or info.st_uid != 0:
            raise ValueError("unsafe socket")
        if path == SOCKET:
            if not stat.S_ISSOCK(info.st_mode):
                raise ValueError("not a socket")
        elif not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o022:
            raise ValueError("unsafe socket directory")

def call(method, endpoint, payload=None):
    connection = UnixHTTP("local-tailscaled.sock", timeout=3)
    try:
        body = None if payload is None else json.dumps(payload).encode()
        connection.request(method, "/localapi/v0/" + endpoint, body, {"Content-Type": "application/json"})
        response = connection.getresponse()
        data = response.read(LIMIT + 1)
        if len(data) > LIMIT or not 200 <= response.status < 300:
            raise ValueError("local API rejected operation")
        return json.loads(data) if data.strip() else {}
    finally:
        connection.close()

def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate field")
        result[key] = value
    return result

def validate(request):
    if type(request) is not dict or set(request) != {"action", "changes"}:
        raise ValueError("invalid request")
    action, changes = request["action"], request["changes"]
    if action not in ("connect", "disconnect", "configure", "login") or type(changes) is not dict:
        raise ValueError("invalid action")
    if set(changes) - {"hostname", "acceptDNS", "acceptRoutes", "ssh", "shieldsUp"}:
        raise ValueError("invalid preference")
    if action != "configure" and changes or action == "configure" and not changes:
        raise ValueError("invalid change set")
    for key, value in changes.items():
        if key == "hostname":
            if type(value) is not str or value and not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", value):
                raise ValueError("invalid hostname")
        elif type(value) is not bool:
            raise ValueError("invalid boolean")
    return action, changes

def apply(request):
    action, changes = validate(request)
    state = call("GET", "status?peers=false")
    prefs = call("GET", "prefs")
    backend = state.get("BackendState")
    node = (state.get("Self") or {}).get("ID")
    if action == "connect":
        if backend != "Stopped" or not node or prefs.get("WantRunning") is not False:
            raise ValueError("connection state changed")
        mask = {"WantRunning": True, "WantRunningSet": True}
    elif action == "disconnect":
        if backend not in ("Running", "Starting") or prefs.get("WantRunning") is not True:
            raise ValueError("connection state changed")
        mask = {"WantRunning": False, "WantRunningSet": True}
    elif action == "login":
        if backend != "NeedsLogin":
            raise ValueError("interactive login only while logged out")
        call("POST", "start", {})
        call("PATCH", "prefs", {"WantRunning": True, "WantRunningSet": True, "LoggedOut": False, "LoggedOutSet": True})
        call("POST", "login-interactive", {})
        return
    else:
        if not node or backend not in ("Running", "Stopped"):
            raise ValueError("preferences unavailable")
        mapping = {"hostname": "Hostname", "acceptDNS": "CorpDNS", "acceptRoutes": "RouteAll", "ssh": "RunSSH", "shieldsUp": "ShieldsUp"}
        mask = {}
        for field, value in changes.items():
            upstream = mapping[field]
            if upstream not in prefs:
                raise ValueError("unsupported preference")
            mask[upstream] = value
            mask[upstream + "Set"] = True
    call("PATCH", "prefs", mask)

def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("check", "apply"):
        return 64
    if os.geteuid() != 0:
        return 77
    try:
        trusted_socket()
        if sys.argv[1] == "check":
            call("POST", "check-prefs", {})  # Validation only, never applies preferences.
            print('{"protocol":1,"ready":true}')
        else:
            data = sys.stdin.buffer.read(8193)
            if len(data) > 8192:
                return 64
            request = json.loads(data, object_pairs_hook=unique_object)
            apply(request)
            print('{"protocol":1,"accepted":true}')
        return 0
    except Exception:
        print("Restricted Tailscale request failed; verify permissions and daemon state before retrying.", file=sys.stderr)
        return 1

if __name__ == "__main__":
    sys.exit(main())
